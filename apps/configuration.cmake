# OpenSSL 4.1: apps/include/configuration.h lists the disabled protocols,
# algorithms and features for "openssl list -disabled".  Upstream fills it from
# configdata.pm; we fill it from Configure's lists and our OPENSSL_NO_* values.

file(STRINGS "${CMAKE_SOURCE_DIR}/openssl/Configure" _APPS_CONFIGURE_LINES)
set(_APPS_LIST)
set(_APPS_DISABLABLES_protocols tls1 tls1-method tls1_1 tls1_1-method tls1_2 tls1_2-method tls1_3 dtls1 dtls1-method dtls1_2 dtls1_2-method dtls1_3)
set(_APPS_DISABLABLES_algorithms)
set(_APPS_DISABLABLES_features)
foreach (_LINE IN LISTS _APPS_CONFIGURE_LINES)
    if (_LINE MATCHES "^my @disablables_(protocols|algorithms|features) = \\(")
        set(_APPS_LIST ${CMAKE_MATCH_1})
    elseif (_APPS_LIST AND _LINE MATCHES "^[ ]*\\);")
        set(_APPS_LIST)
    elseif (_APPS_LIST AND _LINE MATCHES "^[ ]*\"([^\"]+)\",?[ ]*$")
        list(APPEND _APPS_DISABLABLES_${_APPS_LIST} "${CMAKE_MATCH_1}")
    endif()
endforeach()

set(OPENSSL_APPS_CONFIGURATION_ARRAYS)
foreach (_APPS_LIST IN ITEMS protocols algorithms features)
    list(SORT _APPS_DISABLABLES_${_APPS_LIST})
    string(APPEND OPENSSL_APPS_CONFIGURATION_ARRAYS "static const char * const openssl_disabled_${_APPS_LIST}[] = {\n\t\"\",\n")
    foreach (_WHAT IN LISTS _APPS_DISABLABLES_${_APPS_LIST})
        # Same exclusions as Configure
        if (_WHAT MATCHES "^(buildtest-c\\+\\+|fips|threads|shared|module|pic|makedepend|sse2|legacy)$")
            continue()
        endif()
        string(TOUPPER "${_WHAT}" _WHAT_UPPER)
        string(REPLACE "-" "_" _WHAT_SYMBOL "${_WHAT_UPPER}")
        if (OPENSSL_NO_${_WHAT_SYMBOL})
            string(APPEND OPENSSL_APPS_CONFIGURATION_ARRAYS "\t\"${_WHAT_UPPER}\",\n")
        endif()
    endforeach()
    string(APPEND OPENSSL_APPS_CONFIGURATION_ARRAYS "};\n\n")
endforeach()

file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/configuration.h" CONTENT [=[
/*
 * WARNING: do not edit!
 * Generated by CMake
 * via apps/configuration.cmake
 *
 * Copyright 2016-2026 The OpenSSL Project Authors. All Rights Reserved.
 *
 * Licensed under the Apache License 2.0 (the "License").  You may not use
 * this file except in compliance with the License.  You can obtain a copy
 * in the file LICENSE in the source distribution or at
 * https://www.openssl.org/source/license.html
 */

#ifndef APPS_CONFIGURATION_H
#define APPS_CONFIGURATION_H

/* clang-format off */
@OPENSSL_APPS_CONFIGURATION_ARRAYS@/* clang-format on */

#endif
]=] @ONLY)

unset(OPENSSL_APPS_CONFIGURATION_ARRAYS)
unset(_WHAT_SYMBOL)
unset(_WHAT_UPPER)
unset(_WHAT)
unset(_APPS_DISABLABLES_features)
unset(_APPS_DISABLABLES_algorithms)
unset(_APPS_DISABLABLES_protocols)
unset(_APPS_LIST)
unset(_LINE)
unset(_APPS_CONFIGURE_LINES)
